

define TokenStart       [ "\u005B" ];  # LEFT SQUARE BRACKET
define TokenEnd         [ "\u005D" ];  # RIGHT SQUARE BRACKET
define TokenBoundary    [ "\u0020" ];  # SPACE

define SyllableStart    [ "\u007B" ];  # LEFT CURLY BRACKET
define SyllableEnd      [ "\u007D" ];  # RIGHT CURLY BRACKET
define SyllableBoundary [ "\u2027" ];  # HYPHENATION POINTs


# Column 1: Labial
define p     {p};
define v     {v};
define f     {f};
define m     {m};
define mm    {mm};


# Column 2: Alveolar
define t     {t};
define z     {z};  
define y     {y};
define s     {s};
define n     {n};
define nn    {nn};


# Column 3: Lateral
define l     {l};
define ll    {ll};

# Column 4: Rhotic
define r     {r};
define rr    {rr};


# Column 5: Velar
define k     {k};
define g     {g};
define gg    {gg};
define ng    {ng};
define ngng  {ngng};


# Column 6: Rounded velar
define kw    {kw};
define w     {w};
define wh    {wh};
define ngw   {ngw};
define ngngw {ngngw};

# Column 7: Uvular
define q     {q};
define gh    {gh};
define ghh   {ghh};

# Column 8: Rounded uvular
define qw    {qw};
define ghw   {ghw};
define ghhw  {ghhw};

# Column 9: Glottal
define h     {h};

# Vowels
define e {e};
define i {i};
define a {a};
define u {u};

# Long vowels
define ii {ii};
define aa {aa};
define uu {uu};


define +Labial   [ p  | v     | f  | m   | mm    ];
define +Alveolar [ t  | z | y | s  | n   | nn    ]; 
define +Lateral  [      l     | ll               ];
define +Rhotic   [      r     | rr               ];
define +Velar    [ k  | g     | gg | ng  | ngng  
                 | kw | w     | wh | ngw | ngngw ];
define +Uvular   [ q  | gh    | ghh              
                 | qw | ghw   | ghhw             ];
define +Glottal  [              h                ];              

define +FullV [ i  | a  | u  ];                    
define +LongV [ ii | aa | uu ];
define Vowel [ e | %+FullV | %+LongV ];

define +Voice    [     v           | m
                 |     z | y       | n
                 |     l
                 |     r
                 |     g           | ng
                 |     w           | ngw
                 |     gh                   
                 |     ghw                       ]; 

define -Voice    [ p          | f        | mm    
                 | t          | s        | nn     
                 |              ll               
                 |              rr               
                 | k          | gg       | ngng  
                 | kw         | wh       | ngngw
                 | q          | ghh              
                 | qw         | ghhw             
                 |              h                ];              


define Consonant [ %-Voice | %+Voice ];


define RawVocabulary [ {ahaay} | {anghi} | {qikmiq} | {sanghhwingngwaaq} ];
push RawVocabulary
pairs


define Token [ Consonant | Vowel ];

define ReversedToken [ Token.r ];

define Tokenize [ ReversedToken @-> TokenEnd ... TokenStart ];

define ReversedTokenizedVocab [ [ RawVocabulary.r .o. Tokenize ] ];
push ReversedTokenizedVocab
pairs

define CVC [ 
   TokenStart Consonant TokenEnd 
   TokenStart Vowel     TokenEnd 
   TokenStart Consonant TokenEnd 
];

define CV [ 
   TokenStart Consonant TokenEnd 
   TokenStart Vowel     TokenEnd
];

define VC [ 
   TokenStart Vowel     TokenEnd 
   TokenStart Consonant TokenEnd 
];

define V [ 
   TokenStart Vowel     TokenEnd
];

define Syllable [ CVC | CV | VC | V ];


define MarkSyllables [ Syllable.r @-> SyllableEnd ... SyllableStart ];

define CleanSyllables [
               SyllableEnd SyllableStart -> SyllableBoundary              ,, 
                  TokenEnd    TokenStart -> TokenBoundary                 ,, 
               SyllableEnd               -> 0                ||     _ .#. ,, 
                           SyllableStart -> 0                || .#. _      ];


define ReversedSyllabizedVocab [ ReversedTokenizedVocab    .o. MarkSyllables  ];
define         SyllabizedVocab [ ReversedSyllabizedVocab.r .o. CleanSyllables ];
push SyllabizedVocab
pairs

define Devoice [ 
               l   <-> ll    ,
               r   <-> rr    ,
               g   <-> gg    , 
               w   <-> wh    , 
               gh  <-> ghh   ,   
               ghw <-> ghhw  || _ TokenEnd SyllableBoundary TokenStart %-Voice  
               ,,
               m   <-> mm    ,
               n   <-> nn    ,
               ng  <-> ngng  ,
               ngw <-> ngngw ,
               l   <-> ll    ,
               r   <-> rr    ,
               g   <-> gg    , 
               w   <-> wh    , 
               gh  <-> ghh   ,   
               ghw <-> ghhw  || %-Voice TokenEnd SyllableBoundary TokenStart _  ];

define UndoubledVocab [ SyllabizedVocab .o. Devoice  ].i; 
push UndoubledVocab
pairs
